# Copy this file to .env before running docker compose.
POSTGRES_PASSWORD=demo
POSTGRES_DB=postgres

# Paste the HTTPS forwarding URL printed by `ngrok http 8000`.
# This value is deliberately not committed.
NGROK_MCP_URL=

# Use one of the model identifiers listed at http://localhost:8790/api/v1/models.
TRUEFORGE_MODEL=anthropic/claude-sonnet-4-6
TRUEFORGE_URL=http://localhost:8790

